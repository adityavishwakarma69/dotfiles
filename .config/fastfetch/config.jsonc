// Load with --config examples/3.jsonc

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type" : "sixel",
      "source" : "/home/aditya/.config/fastfetch/images/chibi.jpeg",
      "height" : 10, 
      "padding" : {
        "left" : 1,
        "right" : 1,
        "top" : 1,
      }
    },
    "display": {
        "size": {
            "binaryPrefix": "si"
        }
    },
    "modules": [
        "custom",
        "os",
        "kernel",
        "cpu",
        "gpu",
        "packages",
        "memory",
        {
            "type": "disk",
            "folders": "/:/home:/boot:/efi"
        },
        "localip"
    ]
}
